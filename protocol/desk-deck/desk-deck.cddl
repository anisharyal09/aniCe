; SPDX-License-Identifier: GPL-3.0-or-later
; Versioned Mac telemetry and trusted-phone controls in authenticated DATA.
desk-deck-v1 = ["aniCe desk deck", 1, kind: 1..6, fields: v1-fields]
desk-deck-v2 = ["aniCe desk deck", 2, kind: 1..10, fields: v2-fields]

v1-fields = capability / subscribe / v1-sample / v1-command / result / stop
v2-fields = capability / subscribe / v2-sample / v2-command / result / stop / renew / catalog-request / catalog-page / catalog-changed

capability = [action-mask: 0..15]
subscribe = [subscription: uuid]
stop = [subscription: uuid]
renew = [subscription: uuid]
catalog-request = [subscription: uuid, page: 0..3]
catalog-page = [subscription: uuid, page: 0..3, page-count: 1..4, catalog-revision: uuid, entries: [* shortcut]]
catalog-changed = [subscription: uuid, catalog-revision: uuid]
shortcut = [shortcut-id: uuid, name: tstr .size (1..320)] ; at most 80 UTF-16 code units, no control characters

v1-sample = [subscription: uuid, sequence: 1..4294967295, cpu-percent: -1..100,
  memory-used: 0..9223372036854775807, memory-total: 0..9223372036854775807,
  thermal-state: 0..3, action-mask: 0..15,
  output-supported: bool, output-target: tstr, output-revision: tstr, output-level: -1..100,
  microphone-supported: bool, microphone-target: tstr, microphone-revision: tstr, microphone-muted: bool,
  brightness-supported: bool, brightness-target: tstr, brightness-revision: tstr, brightness-level: -1..100]

v2-sample = [subscription: uuid, sequence: 1..4294967295, cpu-percent: -1..100,
  active-bytes: 0..9223372036854775807, wired-bytes: 0..9223372036854775807,
  compressed-bytes: 0..9223372036854775807, physical-bytes: 0..9223372036854775807,
  thermal-state: 0..3, action-mask: 0..15,
  output-supported: bool, output-target: tstr, output-revision: tstr, output-level: -1..100,
  microphone-supported: bool, microphone-target: tstr, microphone-revision: tstr, microphone-muted: bool,
  power-state: 0..5, power-percent: -1..100, power-source: 0..3]

v1-command = [subscription: uuid, command-id: 1..4294967295, action: 1..7,
  target: tstr, revision: tstr, value: -1..100]
v2-command = [subscription: uuid, command-id: 1..4294967295, action: 1 / 2 / 5 / 6 / 8,
  target: tstr, revision: tstr, value: -1..100]
result = [subscription: uuid, command-id: 1..4294967295, result: 0..7]

uuid = tstr .size 36
; Action-specific identity/value constraints and cross-field sums are normative in README.md.
