; SPDX-License-Identifier: GPL-3.0-or-later
; Defines deterministic bounded media v1 messages within existing authenticated DATA records.
media = capability / subscribe / acknowledgement / unsubscribe / snapshot / command / command-result / artwork
capability = ["aniCe media", 1, 1, [version: 1, artwork: bool]]
subscribe = ["aniCe media", 1, 2, [subscription: uuid]]
acknowledgement = ["aniCe media", 1, 3, [subscription: uuid]]
unsubscribe = ["aniCe media", 1, 4, [subscription: uuid]]
snapshot = ["aniCe media", 1, 5, [subscription: uuid, source: optional-uuid, revision: optional-uuid,
  title: tstr .size (0..512), artist: tstr .size (0..256), player: tstr .size (0..96),
  state: 0..3, position-ms: -1..604800000, duration-ms: -1..604800000, rate-milli: 0..16000,
  actions: 0..31, selection: optional-uuid, catalogue: uuid,
  sources: [0*16 [source: uuid, name: tstr .size (0..96), state: 0..3]], artwork-hash: bstr .size 0 / bstr .size 32]]
command = ["aniCe media", 1, 6, [subscription: uuid, id: 1..4294967295,
  source: optional-uuid, revision: uuid, action: 1..6, argument-ms: 0..604800000]]
command-result = ["aniCe media", 1, 7, [subscription: uuid, id: 1..4294967295, result: 0..7]]
artwork = ["aniCe media", 1, 8, [subscription: uuid, source: uuid, revision: uuid,
  hash: bstr .size 32, total: 1..65536, offset: 0..65535, chunk: bstr .size (1..2048)]]
uuid = tstr .size 36
optional-uuid = "" / uuid
; Additional invariants and channel/lifecycle rules are normative in README.md.
