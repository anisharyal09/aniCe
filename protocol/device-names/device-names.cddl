; Existing secured DATA only; name additionally requires trimmed nonblank 1..64 Unicode code points.
device-names = ["aniCe device names", 1, 1, [1]] /
               ["aniCe device names", 1, 2, [revision, name]]
revision = uint .le 9223372036854775807
name = tstr .size (1..256)
