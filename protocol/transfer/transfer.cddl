; SPDX-License-Identifier: GPL-3.0-or-later
; Defines deterministic bounded transfer v1 messages carried by authenticated DATA records.
transfer = capability / offer / accept / reject / chunk / ack / file-result / batch-result / cancel / resume / status / lan-capability / lan-chunk

capability = ["aniCe transfer", 1, 1, [version: 1, max-chunk-bytes: 1..3072, max-window: 1..64]]
offer = ["aniCe transfer", 1, 2, [batch: uuid, slice-index: 0..15, total-slices: 1..16,
  total-files: 1..128, total-bytes: 0..9223372036854775807,
  files: [1*8 [file: uuid, name: tstr .size (1..255), size: 0..9223372036854775807, hash: bstr .size 32]]]]
accept = ["aniCe transfer", 1, 3, [batch: uuid, files: [0*64 uuid]]]
reject = ["aniCe transfer", 1, 4, [batch: uuid, reason: 0..4]]
chunk = ["aniCe transfer", 1, 5, [batch: uuid, file: uuid, offset: 0..9223372036854775807, data: bstr .size (1..3072)]]
ack = ["aniCe transfer", 1, 6, [batch: uuid, file: uuid, written: 0..9223372036854775807]]
file-result = ["aniCe transfer", 1, 7, [batch: uuid, file: uuid, result: 0..3, hash: bstr .size 32]]
batch-result = ["aniCe transfer", 1, 8, [batch: uuid, result: 0..3]]
cancel = ["aniCe transfer", 1, 9, [batch: uuid, file: optional-uuid, reason: 0..4]]
resume = ["aniCe transfer", 1, 10, [batch: uuid, file: uuid, offset: 0..9223372036854775807, prefix-hash: bstr .size 32]]
status = ["aniCe transfer", 1, 11, [batch: uuid, file: optional-uuid, bytes-transferred: 0..9223372036854775807, state: 0..4]]

uuid = tstr .size 36
optional-uuid = "" / uuid

; Capability 2 and larger chunks require the authenticated LAN profile 3.
lan-capability = ["aniCe transfer", 1, 1, [version: 2, max-chunk-bytes: 1..131072, max-window: 1..8]]
lan-chunk = ["aniCe transfer", 1, 5, [batch: uuid, file: uuid, offset: 0..9223372036854775807, data: bstr .size (1..131072)]]
