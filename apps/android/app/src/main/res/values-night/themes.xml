<!-- Defines native dark windows, sharing and connection setup before Compose content loads. -->
<resources>
    <style name="Theme.AniCe" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#191E22</item>
        <item name="android:colorAccent">#A7C5D6</item>
    </style>
    <style name="Theme.AniCe.ClipboardAction" parent="android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">85%</item>
    </style>
    <style name="Theme.AniCe.ConnectionSetup" parent="android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">85%</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">#C4CCC5</item>
    </style>
</resources>
