<!-- Declares local network, Automation and system-audio capture purposes and pinned update certificates. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>AniceUpdateCertificatePins</key><string>$(ANICE_UPDATE_PINS)</string>
<key>NSAppleEventsUsageDescription</key><string>aniCe controls the media player you select when you explicitly allow playback control.</string>
<key>NSAudioCaptureUsageDescription</key><string>aniCe captures system audio when you prepare Audio Sharing to send it securely to your Android device.</string>
<key>NSBonjourServices</key><array><string>_anice._tcp</string></array>
<key>NSLocalNetworkUsageDescription</key><string>aniCe uses your local network to connect securely to your paired devices.</string>
</dict></plist>
